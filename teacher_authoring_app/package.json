{
  "name": "tedtronics-teacher-authoring-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "validator": "node scripts/venv.mjs uvicorn graph_validator.service.app:app --host 0.0.0.0 --port 8000",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src tests vite.config.ts scripts",
    "format": "biome format --write src tests vite.config.ts",
    "check": "biome check src tests vite.config.ts",
    "migrate": "node scripts/venv.mjs alembic -c ../graph_validator/alembic.ini upgrade head",
    "bench-service": "node scripts/venv.mjs python -m bench_service --dev --db ../bench/service/bench.sqlite3"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^5.4.6"
  }
}
